# Copy to .env.local and fill in. Never commit .env.local.
# The public marketing site runs fine with none of these set (forms will
# validate and accept input but only log submissions instead of emailing).
# The admin panel at /admin needs MONGODB_URI + ADMIN_JWT_SECRET to function.

# --- Site -------------------------------------------------------------------
# Public origin. Used for canonical URLs, sitemap.xml and robots.txt.
# Must keep the NEXT_PUBLIC_ prefix: client components read it too, and a
# server-only value would differ between server and browser during hydration.
NEXT_PUBLIC_SITE_URL="https://swifthire.com"

# --- Email delivery (Resend) ------------------------------------------------
# All four must be set together to enable delivery.
RESEND_API_KEY=""
EMAIL_FROM="Swift Hire <notifications@swifthire.com>"
EMAIL_TO_SALES="hello@swifthire.com"
EMAIL_TO_TALENT="engineers@swifthire.com"

# --- Scheduling -------------------------------------------------------------
# Calendly (or Cal.com) event URL embedded on /contact.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/swifthire/discovery-call"

# --- Analytics --------------------------------------------------------------
# GA4 measurement id. Leave empty to disable analytics entirely.
# Even when set, nothing loads until the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=""

# --- Admin panel (/admin) ---------------------------------------------------
# MongoDB connection string. Local dev can use mongodb://127.0.0.1:27017/…;
# production should use a MongoDB Atlas URI. Required for anything under /admin
# or /api/admin to work.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# JWT signing secret for admin auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# In dev the code will fall back to JWT_SECRET if ADMIN_JWT_SECRET is missing,
# but always set ADMIN_JWT_SECRET explicitly in production.
ADMIN_JWT_SECRET=""

# Token lifetime (any zeit/ms string). Default 7d.
ADMIN_JWT_EXPIRES_IN="7d"
