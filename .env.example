# Copy to .env.local and fill in. Never commit .env.local.
# Every variable is optional: with none set, the site runs and the forms
# validate and accept input, but submissions are only logged, not emailed.

# --- Site -------------------------------------------------------------------
# Public origin. Used for canonical URLs, sitemap.xml and robots.txt.
# Must keep the NEXT_PUBLIC_ prefix: client components read it too, and a
# server-only value would differ between server and browser during hydration.
NEXT_PUBLIC_SITE_URL="https://swifthire.com"

# --- Email delivery (Resend) ------------------------------------------------
# All four must be set together to enable delivery.
RESEND_API_KEY=""
EMAIL_FROM="Swift Hire <notifications@swifthire.com>"
EMAIL_TO_SALES="hello@swifthire.com"
EMAIL_TO_TALENT="engineers@swifthire.com"

# --- Scheduling -------------------------------------------------------------
# Calendly (or Cal.com) event URL embedded on /contact.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/swifthire/discovery-call"

# --- Analytics --------------------------------------------------------------
# GA4 measurement id. Leave empty to disable analytics entirely.
# Even when set, nothing loads until the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=""
